Q8. Person and Student Class
Python
class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age

class Student(Person):
    def __init__(self, name, age, roll_number):
        super().__init__(name, age)
        self.roll_number = roll_number

s = Student("Riya", 19, 25)

print("Name:", s.name)
print("Age:", s.age)
print("Roll Number:", s.roll_number)
Output:
Plain text
Name: Riya
Age: 19
Roll Number: 25



Q9. Calculator Class
Python
class Calculator:
    def add(self, a, b):
        return a + b

    def subtract(self, a, b):
        return a - b

    def multiply(self, a, b):
        return a * b

    def divide(self, a, b):
        return a / b

c = Calculator()

a = 20
b = 5

print("Addition =", c.add(a, b))
print("Subtraction =", c.subtract(a, b))
print("Multiplication =", c.multiply(a, b))
print("Division =", c.divide(a, b))
Output:
Plain text
